# git-ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
*.[oa]
*~
moc_*.cpp
ui_*.h
.*.sw?
qrc_*.cpp
Makefile
glogg
glogg_tests
massif.out*
core.*
doc/*.html
*.exe

# File generated by Qt Creator
glogg.config
glogg.creator
glogg.creator.user
glogg.files
glogg.includes
glogg.pro.user
Makefile.Debug
Makefile.Release
debug/
release/
object_script.glogg.Debug
object_script.glogg.Release
glogg_resource.rc

# Tests
tests/build/

# Qt-specific
/.moc
/.obj
/.ui
/.qmake.stash

# Editor / IDE local state — not part of the project
.vscode/
.idea/
.vs/
*.user
*.user.*
*.autosave
compile_commands.json
.clangd/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Runtime output (glogg -l writes glogg_<pid>.log)
glogg_*.log
