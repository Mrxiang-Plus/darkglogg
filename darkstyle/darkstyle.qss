/* VSCode Dark+ - Strong Layering */

/* Layer 5 (deepest): #171717 - Editor, Content, Scrollbar bg */
/* Layer 4: #1e1e1e - Tab pane, Tree/Table */
/* Layer 3: #252525 - Tab bar inactive, GroupBox, Menu, Tooltip */
/* Layer 2: #333333 - Toolbar, Sidebar, Input fields */
/* Layer 1 (top): #3e3e3e - MenuBar, Title bar */
/* Accent: #007acc - Status bar, Focus, Selection */

QToolTip{
  color:#cccccc;
  background-color:#252525;
  border:1px solid #4a4a4a;
  border-radius:4px;
  padding:4px;
}
QFrame { border: 0px; }

/* ===== ComboBox ===== */
QComboBox {
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    background-color:#333333;
    color:#cccccc;
    padding:3px 6px;
    min-height: 20px;
}
QComboBox:hover { border: 1px solid #666666; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
    border-left-color: #4a4a4a;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}
QComboBox::down-arrow {
    image:url(:/darkstyle/icon_branch_open.png);
    background-position: center center;
}
QComboBox:focus { border: 1px solid #007acc; color: white; }
QComboBox QAbstractItemView {
    background-color:#252525;
    color:#cccccc;
    selection-background-color:#094771;
    border:1px solid #4a4a4a;
}
QListView {
    font-size:10pt;
    background-color:#171717;
    color:#cccccc;
}

/* ===== StatusBar - Accent layer ===== */
QStatusBar{
  background-color:#007acc;
  color:#ffffff;
  font-size:9pt;
  font-weight:bold;
  border:none;
}

/* ===== Input - Layer 2 ===== */
QLineEdit{
    background-color:#333333;
    border:1px solid #4a4a4a;
    border-radius:3px;
    font-size:9pt;
    color:#cccccc;
    padding:3px 6px;
    min-height: 20px;
}
QLineEdit:hover { border:1px solid #666666; }
QLineEdit:focus { border:1px solid #007acc; }

/* ===== MenuBar - Layer 1 (top chrome) ===== */
QMenuBar{
  font-size:9pt;
  color:#cccccc;
  background-color:#3e3e3e;
  border-bottom:2px solid #4a4a4a;
}
QMenuBar::item{
  font-size:9pt;
  spacing:2px;
  padding:4px 8px;
  background:transparent;
}
QMenuBar::item:selected{
  background-color:#094771;
  color:#ffffff;
}
QMenuBar::item:pressed{
  background-color:#007acc;
  color:#ffffff;
}

/* ===== Menu - Layer 3 ===== */
QMenu{
  background-color:#252525;
  border:1px solid #4a4a4a;
}
QMenu::item{
  font-size:9pt;
  padding:4px 25px 4px 25px;
  border:1px solid transparent;
  color:#cccccc;
}
QMenu::item:disabled{
  background-color:#1e1e1e;
  color:#5a5a5a;
}
QMenu::item:selected{
  border-color:#094771;
  background:#094771;
  color:#ffffff;
}
QMenu::icon:checked{
  background-color:#007acc;
  border:1px solid #007acc;
  border-radius:2px;
}
QMenu::separator{
  height:1px;
  background:#4a4a4a;
  margin-left:5px;
  margin-right:5px;
}
QMenu::indicator{ width:18px; height:18px; }
QMenu::indicator:non-exclusive:checked{
  image:url(:/darkstyle/icon_checkbox_checked.png);
  padding-left:2px;
}
QMenu::indicator:non-exclusive:unchecked{
  image:url(:/darkstyle/icon_checkbox_unchecked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:checked{
  image:url(:/darkstyle/icon_radiobutton_checked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:unchecked{
  image:url(:/darkstyle/icon_radiobutton_unchecked.png);
  padding-left:2px;
}

/* ===== ToolBar - Layer 2 ===== */
QToolBar{
  background-color:#333333;
  border:none;
  spacing:2px;
  padding:2px;
}
QToolBar::top{
  background-color:#333333;
  border-bottom:2px solid #4a4a4a;
}
QToolBar::bottom{
  background-color:#333333;
  border-top:2px solid #4a4a4a;
}
QToolBar::left{
  background-color:#333333;
  border-right:2px solid #4a4a4a;
}
QToolBar::right{
  background-color:#333333;
  border-left:2px solid #4a4a4a;
}

/* ===== Splitter ===== */
QMainWindow::separator{
  width:6px;
  height:5px;
  padding:2px;
}
QSplitter::handle:horizontal{ width:4px; }
QSplitter::handle:vertical{ height:4px; }
QSplitter::handle {
  background-color:#4a4a4a;
}
QMainWindow::separator:hover,QSplitter::handle:hover{
  background-color:#007acc;
}

/* ===== DockWidget ===== */
QDockWidget::title{
  padding:4px;
  background-color:#333333;
  border:1px solid #4a4a4a;
  border-bottom:1px solid #4a4a4a;
  color:#cccccc;
}
QDockWidget{
  titlebar-close-icon:url(:/darkstyle/icon_close.png);
  titlebar-normal-icon:url(:/darkstyle/icon_restore.png);
}
QDockWidget::close-button,QDockWidget::float-button{
  subcontrol-position:top right;
  subcontrol-origin:margin;
  position:absolute;
  top:3px;
  bottom:0px;
  width:20px;
  height:20px;
}
QDockWidget::close-button{ right:3px; }
QDockWidget::float-button{ right:25px; }

/* ===== GroupBox - Layer 3 ===== */
QGroupBox{
  background-color:#252525;
  margin-top:27px;
  border:2px solid #4a4a4a;
  border-radius:4px;
  color:#cccccc;
  padding-top: 5px;
}
QGroupBox::title{
  subcontrol-origin:margin;
  subcontrol-position:left top;
  padding:4px 8px;
  margin-left:3px;
  background-color:#3e3e3e;
  border:1px solid #4a4a4a;
  border-bottom:2px solid #007acc;
  border-top-left-radius:4px;
  border-top-right-radius:4px;
  color:#ffffff;
}

/* ===== TabWidget ===== */
QTabWidget { border:0px; background-color:transparent; }
QTabWidget::pane{
  background-color:#171717;
  border:2px solid #4a4a4a;
  border-top:0px;
}
QTabWidget::close-button{
  image:url(:/darkstyle/icon_close.png);
  right:3px;
}
QTabWidget::tab-bar{ left:3px; top:1px; }

/* ===== TabBar - Layer 3 ===== */
QTabBar{
  background-color:#252525;
  qproperty-drawBase:0;
  border-bottom:2px solid #4a4a4a;
}
QTabBar::close-button {
    height: 6px;
    width: 6px;
    image:url(:/images/darkclosebutton.png);
    subcontrol-origin: padding;
    subcontrol-position: right;
}
QTabBar::tab{
  height:17px;
  padding:6px 10px;
  background-color:#252525;
  font-size: 9pt;
  color: #808080;
  border-top-left-radius:4px;
  border-top-right-radius:4px;
  border-right:1px solid #171717;
}
QTabBar::tab:selected,QTabBar::tab:hover{
    background-color:#171717;
    color:#ffffff;
}
QTabBar::tab:selected{
  color: #ffffff;
  border-bottom:3px solid #007acc;
}
QTabBar::tab::selected:disabled{
  border-bottom:3px solid #5a5a5a;
}
QTabBar::tab:!selected{
  background-color:#252525;
  border-bottom:3px solid transparent;
}

/* ===== CheckBox / RadioButton ===== */
QCheckBox{
    font-size:13px;
  color:#cccccc;
  spacing: 6px;
}
QCheckBox::indicator{ width:16px; height:16px; }
QCheckBox::indicator:checked,QTreeView::indicator:checked,QTableView::indicator:checked,QGroupBox::indicator:checked{
  image:url(:/darkstyle/icon_checkbox_checked.png);
}
QCheckBox::indicator:checked:pressed,QTreeView::indicator:checked:pressed,QTableView::indicator:checked:pressed,QGroupBox::indicator:checked:pressed{
  image:url(:/darkstyle/icon_checkbox_checked_pressed.png);
}
QCheckBox::indicator:checked:disabled,QTreeView::indicator:checked:disabled,QTableView::indicator:checked:disabled,QGroupBox::indicator:checked:disabled{
  image:url(:/darkstyle/icon_checkbox_checked_disabled.png);
}
QCheckBox::indicator:unchecked,QTreeView::indicator:unchecked,QTableView::indicator:unchecked,QGroupBox::indicator:unchecked{
  image:url(:/darkstyle/icon_checkbox_unchecked.png);
}
QCheckBox::indicator:unchecked:pressed,QTreeView::indicator:unchecked:pressed,QTableView::indicator:unchecked:pressed,QGroupBox::indicator:unchecked:pressed{
  image:url(:/darkstyle/icon_checkbox_unchecked_pressed.png);
}
QCheckBox::indicator:unchecked:disabled,QTreeView::indicator:unchecked:disabled,QTableView::indicator:unchecked:disabled,QGroupBox::indicator:unchecked:disabled{
  image:url(:/darkstyle/icon_checkbox_unchecked_disabled.png);
}
QCheckBox::indicator:indeterminate,QTreeView::indicator:indeterminate,QTableView::indicator:indeterminate,QGroupBox::indicator:indeterminate{
  image:url(:/darkstyle/icon_checkbox_indeterminate.png);
}
QCheckBox::indicator:indeterminate:pressed,QTreeView::indicator:indeterminate:pressed,QTableView::indicator:indeterminate:pressed,QGroupBox::indicator:indeterminate:pressed{
  image:url(:/darkstyle/icon_checkbox_indeterminate_pressed.png);
}
QCheckBox::indicator:indeterminate:disabled,QTreeView::indicator:indeterminate:disabled,QTableView::indicator:indeterminate:disabled,QGroupBox::indicator:indeterminate:disabled{
  image:url(:/darkstyle/icon_checkbox_indeterminate_disabled.png);
}
QRadioButton::indicator{ width:16px; height:16px; }
QRadioButton::indicator:checked{ image:url(:/darkstyle/icon_radiobutton_checked.png); }
QRadioButton::indicator:checked:pressed{ image:url(:/darkstyle/icon_radiobutton_checked_pressed.png); }
QRadioButton::indicator:checked:disabled{ image:url(:/darkstyle/icon_radiobutton_checked_disabled.png); }
QRadioButton::indicator:unchecked{ image:url(:/darkstyle/icon_radiobutton_unchecked.png); }
QRadioButton::indicator:unchecked:pressed{ image:url(:/darkstyle/icon_radiobutton_unchecked_pressed.png); }
QRadioButton::indicator:unchecked:disabled{ image:url(:/darkstyle/icon_radiobutton_unchecked_disabled.png); }

/* ===== ToolButton - Layer 2 ===== */
QToolButton{
    font-size:13px;
  color:#cccccc;
  background-color:#333333;
  border:1px solid #4a4a4a;
  border-radius:3px;
  padding:4px 8px;
}
QToolButton:hover{
  background-color:#454545;
  border:1px solid #666666;
}
QToolButton:pressed{
  background-color:#007acc;
  border:1px solid #007acc;
  color:#ffffff;
}
QLabel{
    font-size:13px;
    color:#cccccc;
    background-color:transparent;
}

/* ===== TreeView / TableView - Layer 5 (deepest) ===== */
QTreeView, QTableView{
  alternate-background-color:#171717;
  background:#171717;
  color:#cccccc;
  border:2px solid #4a4a4a;
  gridline-color: #2a2a2a;
}
QTreeView QHeaderView::section, QTableView QHeaderView::section{
  background-color:#333333;
  border-style:none;
  border-bottom:3px solid #007acc;
  padding-left:5px;
  padding-right:5px;
  color:#ffffff;
  font-weight:bold;
}
QTreeView::item:selected, QTableView::item:selected{
  background:#094771;
  color:#ffffff;
}
QTreeView::item:selected:disabled, QTableView::item:selected:disabled{
  background:#333333;
}
QTreeView::item:hover, QTableView::item:hover{
  background:#2a2a2a;
}
QTreeView::branch{ background-color:#171717; }
QTreeView::branch:has-siblings:!adjoins-item{
  border-image:url(:/darkstyle/icon_vline.png) 0;
}
QTreeView::branch:has-siblings:adjoins-item{
  border-image:url(:/darkstyle/icon_branch_more.png) 0;
}
QTreeView::branch:!has-children:!has-siblings:adjoins-item{
  border-image:url(:/darkstyle/icon_branch_end.png) 0;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings{
  border-image:none;
  image:url(:/darkstyle/icon_branch_closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings{
  border-image:none;
  image:url(:/darkstyle/icon_branch_open.png);
}

/* ===== ScrollBar - Layer 5 bg ===== */
QScrollBar:vertical{
  background:#171717;
  border-top-right-radius:2px;
  border-bottom-right-radius:2px;
  width:14px;
  margin:0px;
}
QScrollBar::handle:vertical{
  background-color:#5a5a5a;
  border-radius:2px;
  min-height:20px;
  margin:2px 4px 2px 4px;
}
QScrollBar::handle:vertical:hover{ background-color:#888888; }
QScrollBar::add-line:vertical{
  background:none;
  height:0px;
  subcontrol-position:right;
  subcontrol-origin:margin;
}
QScrollBar::sub-line:vertical{
  background:none;
  height:0px;
  subcontrol-position:left;
  subcontrol-origin:margin;
}
QScrollBar:horizontal{
  background:#171717;
  height:14px;
  margin:0px;
}
QScrollBar::handle:horizontal{
  background-color:#5a5a5a;
  border-radius:2px;
  min-width:20px;
  margin:4px 2px 4px 2px;
}
QScrollBar::handle:horizontal:hover{ background-color:#888888; }
QScrollBar::add-line:horizontal{
  background:none;
  width:0px;
  subcontrol-position:bottom;
  subcontrol-origin:margin;
}
QScrollBar::sub-line:horizontal{
  background:none;
  width:0px;
  subcontrol-position:top;
  subcontrol-origin:margin;
}

/* ===== Slider ===== */
QSlider::handle:horizontal{
  border-radius:4px;
  border:2px solid #007acc;
  background-color:#cccccc;
  min-height:20px;
  margin:0 -4px;
}
QSlider::handle:horizontal:hover{
  background:#007acc;
  border:2px solid #4fc1ff;
}
QSlider::add-page:horizontal{
  background:#333333;
  border-radius:2px;
}
QSlider::sub-page:horizontal{
  background:#007acc;
  border-radius:2px;
}
QSlider::sub-page:horizontal:disabled{
  background:#333333;
}

/* ===== PushButton ===== */
QPushButton{
  background-color:#0e639c;
  color:#ffffff;
  border:1px solid #1177bb;
  border-radius:3px;
  padding:5px 16px;
  font-size:11px;
  font-weight:bold;
  min-height: 22px;
}
QPushButton:hover{
  background-color:#1177bb;
  border:1px solid #4fc1ff;
}
QPushButton:pressed{
  background-color:#094771;
  border:1px solid #007acc;
}
QPushButton:disabled{
  background-color:#252525;
  color:#5a5a5a;
  border:1px solid #333333;
}
QPushButton:focus{
  border:1px solid #4fc1ff;
}

/* ===== SpinBox ===== */
QSpinBox{
  background-color:#333333;
  border:1px solid #4a4a4a;
  border-radius:3px;
  color:#cccccc;
  padding:2px 4px;
}
QSpinBox:hover { border:1px solid #666666; }
QSpinBox:focus { border:1px solid #007acc; }

/* ===== ProgressBar ===== */
QProgressBar{
  background-color:#333333;
  border:1px solid #4a4a4a;
  border-radius:3px;
  text-align:center;
  color:#ffffff;
}
QProgressBar::chunk{
  background-color:#007acc;
  border-radius:2px;
}
