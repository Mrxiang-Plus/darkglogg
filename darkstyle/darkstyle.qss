/* VSCode Dark+ inspired stylesheet - Strong layering */

/* ===== Tooltip ===== */
QToolTip{
  color:#cccccc;
  background-color:#252526;
  border:1px solid #454545;
  border-radius:4px;
  padding:4px;
}
QFrame {
    border: 0px;
}

/* ===== ComboBox ===== */
QComboBox {
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color:#3c3c3c;
    color:#cccccc;
    padding:3px 6px;
    min-height: 20px;
}
QComboBox:hover {
    border: 1px solid #707070;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
    border-left-color: #3c3c3c;
    border-left-style: solid;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}
QComboBox::down-arrow {
    image:url(:/darkstyle/icon_branch_open.png);
    background-position: center center;
}
QComboBox:focus {
    border: 1px solid #007acc;
    color: white;
}
QComboBox QAbstractItemView {
    background-color:#252526;
    color:#cccccc;
    selection-background-color:#094771;
    border:1px solid #454545;
}
QListView {
    font-size:10pt;
    background-color:#1e1e1e;
    color:#cccccc;
}

/* ===== StatusBar - Layer 1 (top) ===== */
QStatusBar{
  background-color:#007acc;
  color:#ffffff;
  font-size:9pt;
  font-weight:bold;
  border:none;
}

/* ===== Input fields ===== */
QLineEdit{
    background-color:#3c3c3c;
    border:1px solid #3c3c3c;
    border-radius:3px;
    font-size:9pt;
    color:#cccccc;
    padding:3px 6px;
    min-height: 20px;
}
QLineEdit:hover{
    border:1px solid #707070;
}
QLineEdit:focus{
    border:1px solid #007acc;
}

/* ===== MenuBar - Layer 2 ===== */
QMenuBar{
  font-size:9pt;
  color:#cccccc;
  background-color:#323233;
  border-bottom:1px solid #3c3c3c;
}
QMenuBar::item{
  font-size:9pt;
  spacing:2px;
  padding:4px 8px;
  background:transparent;
}
QMenuBar::item:selected{
  background-color:#094771;
  color:#ffffff;
}
QMenuBar::item:pressed{
  background-color:#007acc;
  color:#ffffff;
}

/* ===== Menu ===== */
QMenu{
  background-color:#252526;
  border:1px solid #454545;
}
QMenu::item{
  font-size:9pt;
  padding:4px 25px 4px 25px;
  border:1px solid transparent;
  color:#cccccc;
}
QMenu::item:disabled{
  background-color:#2d2d2d;
  color:#5a5a5a;
}
QMenu::item:selected{
  border-color:#094771;
  background:#094771;
  color:#ffffff;
}
QMenu::icon:checked{
  background-color:#007acc;
  border:1px solid #007acc;
  border-radius:2px;
}
QMenu::separator{
  height:1px;
  background:#454545;
  margin-left:5px;
  margin-right:5px;
}
QMenu::indicator{
  width:18px;
  height:18px;
}
QMenu::indicator:non-exclusive:checked{
  image:url(:/darkstyle/icon_checkbox_checked.png);
  padding-left:2px;
}
QMenu::indicator:non-exclusive:unchecked{
  image:url(:/darkstyle/icon_checkbox_unchecked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:checked{
  image:url(:/darkstyle/icon_radiobutton_checked.png);
  padding-left:2px;
}
QMenu::indicator:exclusive:unchecked{
  image:url(:/darkstyle/icon_radiobutton_unchecked.png);
  padding-left:2px;
}

/* ===== ToolBar - Layer 2 ===== */
QToolBar{
  background-color:#252526;
  border:none;
  spacing:2px;
  padding:2px;
}
QToolBar::top{
  background-color:#252526;
  border-bottom:1px solid #3c3c3c;
}
QToolBar::bottom{
  background-color:#252526;
  border-top:1px solid #3c3c3c;
}
QToolBar::left{
  background-color:#252526;
  border-right:1px solid #3c3c3c;
}
QToolBar::right{
  background-color:#252526;
  border-left:1px solid #3c3c3c;
}

/* ===== Splitter ===== */
QMainWindow::separator{
  width:6px;
  height:5px;
  padding:2px;
}
QSplitter::handle:horizontal{
  width:4px;
}
QSplitter::handle:vertical{
  height:4px;
}
QSplitter::handle {
  background-color:#454545;
}
QMainWindow::separator:hover,QSplitter::handle:hover{
  background-color:#007acc;
}

/* ===== DockWidget ===== */
QDockWidget::title{
  padding:4px;
  background-color:#252526;
  border:1px solid #3c3c3c;
  border-bottom:1px solid #3c3c3c;
  color:#cccccc;
}
QDockWidget{
  titlebar-close-icon:url(:/darkstyle/icon_close.png);
  titlebar-normal-icon:url(:/darkstyle/icon_restore.png);
}
QDockWidget::close-button,QDockWidget::float-button{
  subcontrol-position:top right;
  subcontrol-origin:margin;
  position:absolute;
  top:3px;
  bottom:0px;
  width:20px;
  height:20px;
}
QDockWidget::close-button{
  right:3px;
}
QDockWidget::float-button{
  right:25px;
}

/* ===== GroupBox - Layer 2 ===== */
QGroupBox{
  background-color:#252526;
  margin-top:27px;
  border:1px solid #3c3c3c;
  border-radius:4px;
  color:#cccccc;
  padding-top: 5px;
}
QGroupBox::title{
  subcontrol-origin:margin;
  subcontrol-position:left top;
  padding:4px 8px;
  margin-left:3px;
  background-color:#3c3c3c;
  border:1px solid #454545;
  border-bottom:2px solid #007acc;
  border-top-left-radius:4px;
  border-top-right-radius:4px;
  color:#ffffff;
}

/* ===== TabWidget - Layer structure ===== */
QTabWidget {
    border:0px;
    background-color:transparent;
}
QTabWidget::pane{
  background-color:#1e1e1e;
  border:1px solid #3c3c3c;
  border-top:0px;
}
QTabWidget::close-button{
  image:url(:/darkstyle/icon_close.png);
  right:3px;
}
QTabWidget::tab-bar{
  left:3px;
  top:1px;
}

/* ===== TabBar ===== */
QTabBar{
  background-color:#2d2d2d;
  qproperty-drawBase:0;
  border-bottom:1px solid #3c3c3c;
}
QTabBar::close-button {
    height: 6px;
    width: 6px;
    image:url(:/images/darkclosebutton.png);
    subcontrol-origin: padding;
    subcontrol-position: right;
}
QTabBar::tab{
  height:17px;
  padding:6px 10px;
  background-color:#2d2d2d;
  font-size: 9pt;
  color: #969696;
  border-top-left-radius:4px;
  border-top-right-radius:4px;
  border-right:1px solid #1e1e1e;
}
QTabBar::tab:selected,QTabBar::tab:hover{
    background-color:#1e1e1e;
    color:#ffffff;
}
QTabBar::tab:selected{
  color: #ffffff;
  border-bottom:2px solid #007acc;
}
QTabBar::tab::selected:disabled{
  border-bottom:2px solid #5a5a5a;
}
QTabBar::tab:!selected{
  background-color:#2d2d2d;
  border-bottom:2px solid transparent;
}

/* ===== CheckBox / RadioButton ===== */
QCheckBox{
    font-size:13px;
  color:#cccccc;
  spacing: 6px;
}
QCheckBox::indicator{
  width:16px;
  height:16px;
}
QCheckBox::indicator:checked,QTreeView::indicator:checked,QTableView::indicator:checked,QGroupBox::indicator:checked{
  image:url(:/darkstyle/icon_checkbox_checked.png);
}
QCheckBox::indicator:checked:pressed,QTreeView::indicator:checked:pressed,QTableView::indicator:checked:pressed,QGroupBox::indicator:checked:pressed{
  image:url(:/darkstyle/icon_checkbox_checked_pressed.png);
}
QCheckBox::indicator:checked:disabled,QTreeView::indicator:checked:disabled,QTableView::indicator:checked:disabled,QGroupBox::indicator:checked:disabled{
  image:url(:/darkstyle/icon_checkbox_checked_disabled.png);
}
QCheckBox::indicator:unchecked,QTreeView::indicator:unchecked,QTableView::indicator:unchecked,QGroupBox::indicator:unchecked{
  image:url(:/darkstyle/icon_checkbox_unchecked.png);
}
QCheckBox::indicator:unchecked:pressed,QTreeView::indicator:unchecked:pressed,QTableView::indicator:unchecked:pressed,QGroupBox::indicator:unchecked:pressed{
  image:url(:/darkstyle/icon_checkbox_unchecked_pressed.png);
}
QCheckBox::indicator:unchecked:disabled,QTreeView::indicator:unchecked:disabled,QTableView::indicator:unchecked:disabled,QGroupBox::indicator:unchecked:disabled{
  image:url(:/darkstyle/icon_checkbox_unchecked_disabled.png);
}
QCheckBox::indicator:indeterminate,QTreeView::indicator:indeterminate,QTableView::indicator:indeterminate,QGroupBox::indicator:indeterminate{
  image:url(:/darkstyle/icon_checkbox_indeterminate.png);
}
QCheckBox::indicator:indeterminate:pressed,QTreeView::indicator:indeterminate:pressed,QTableView::indicator:indeterminate:pressed,QGroupBox::indicator:indeterminate:pressed{
  image:url(:/darkstyle/icon_checkbox_indeterminate_pressed.png);
}
QCheckBox::indicator:indeterminate:disabled,QTreeView::indicator:indeterminate:disabled,QTableView::indicator:indeterminate:disabled,QGroupBox::indicator:indeterminate:disabled{
  image:url(:/darkstyle/icon_checkbox_indeterminate_disabled.png);
}
QRadioButton::indicator{
  width:16px;
  height:16px;
}
QRadioButton::indicator:checked{
  image:url(:/darkstyle/icon_radiobutton_checked.png);
}
QRadioButton::indicator:checked:pressed{
  image:url(:/darkstyle/icon_radiobutton_checked_pressed.png);
}
QRadioButton::indicator:checked:disabled{
  image:url(:/darkstyle/icon_radiobutton_checked_disabled.png);
}
QRadioButton::indicator:unchecked{
  image:url(:/darkstyle/icon_radiobutton_unchecked.png);
}
QRadioButton::indicator:unchecked:pressed{
  image:url(:/darkstyle/icon_radiobutton_unchecked_pressed.png);
}
QRadioButton::indicator:unchecked:disabled{
  image:url(:/darkstyle/icon_radiobutton_unchecked_disabled.png);
}

/* ===== ToolButton ===== */
QToolButton{
    font-size:13px;
  color:#cccccc;
  background-color:#3c3c3c;
  border:1px solid #3c3c3c;
  border-radius:3px;
  padding:4px 8px;
}
QToolButton:hover{
  background-color:#505050;
  border:1px solid #707070;
}
QToolButton:pressed{
  background-color:#007acc;
  border:1px solid #007acc;
  color:#ffffff;
}
QLabel{
    font-size:13px;
    color:#cccccc;
    background-color:transparent;
}

/* ===== TreeView / TableView - Layer 1 (deepest) ===== */
QTreeView, QTableView{
  alternate-background-color:#1e1e1e;
  background:#1e1e1e;
  color:#cccccc;
  border:1px solid #3c3c3c;
  gridline-color: #2d2d2d;
}
QTreeView QHeaderView::section, QTableView QHeaderView::section{
  background-color:#252526;
  border-style:none;
  border-bottom:2px solid #007acc;
  padding-left:5px;
  padding-right:5px;
  color:#ffffff;
  font-weight:bold;
}
QTreeView::item:selected, QTableView::item:selected{
  background:#094771;
  color:#ffffff;
}
QTreeView::item:selected:disabled, QTableView::item:selected:disabled{
  background:#3c3c3c;
}
QTreeView::item:hover, QTableView::item:hover{
  background:#2a2d2e;
}
QTreeView::branch{
  background-color:#1e1e1e;
}
QTreeView::branch:has-siblings:!adjoins-item{
  border-image:url(:/darkstyle/icon_vline.png) 0;
}
QTreeView::branch:has-siblings:adjoins-item{
  border-image:url(:/darkstyle/icon_branch_more.png) 0;
}
QTreeView::branch:!has-children:!has-siblings:adjoins-item{
  border-image:url(:/darkstyle/icon_branch_end.png) 0;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings{
  border-image:none;
  image:url(:/darkstyle/icon_branch_closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings{
  border-image:none;
  image:url(:/darkstyle/icon_branch_open.png);
}

/* ===== ScrollBar ===== */
QScrollBar:vertical{
  background:#1e1e1e;
  border-top-right-radius:2px;
  border-bottom-right-radius:2px;
  width:14px;
  margin:0px;
}
QScrollBar::handle:vertical{
  background-color:#5a5a5a;
  border-radius:2px;
  min-height:20px;
  margin:2px 4px 2px 4px;
}
QScrollBar::handle:vertical:hover{
  background-color:#888888;
}
QScrollBar::add-line:vertical{
  background:none;
  height:0px;
  subcontrol-position:right;
  subcontrol-origin:margin;
}
QScrollBar::sub-line:vertical{
  background:none;
  height:0px;
  subcontrol-position:left;
  subcontrol-origin:margin;
}
QScrollBar:horizontal{
  background:#1e1e1e;
  height:14px;
  margin:0px;
}
QScrollBar::handle:horizontal{
  background-color:#5a5a5a;
  border-radius:2px;
  min-width:20px;
  margin:4px 2px 4px 2px;
}
QScrollBar::handle:horizontal:hover{
  background-color:#888888;
}
QScrollBar::add-line:horizontal{
  background:none;
  width:0px;
  subcontrol-position:bottom;
  subcontrol-origin:margin;
}
QScrollBar::sub-line:horizontal{
  background:none;
  width:0px;
  subcontrol-position:top;
  subcontrol-origin:margin;
}

/* ===== Slider ===== */
QSlider::handle:horizontal{
  border-radius:4px;
  border:2px solid #007acc;
  background-color:#cccccc;
  min-height:20px;
  margin:0 -4px;
}
QSlider::handle:horizontal:hover{
  background:#007acc;
  border:2px solid #4fc1ff;
}
QSlider::add-page:horizontal{
  background:#3c3c3c;
  border-radius:2px;
}
QSlider::sub-page:horizontal{
  background:#007acc;
  border-radius:2px;
}
QSlider::sub-page:horizontal:disabled{
  background:#3c3c3c;
}

/* ===== PushButton ===== */
QPushButton{
  background-color:#0e639c;
  color:#ffffff;
  border:1px solid #1177bb;
  border-radius:3px;
  padding:5px 16px;
  font-size:11px;
  font-weight:bold;
  min-height: 22px;
}
QPushButton:hover{
  background-color:#1177bb;
  border:1px solid #4fc1ff;
}
QPushButton:pressed{
  background-color:#094771;
  border:1px solid #007acc;
}
QPushButton:disabled{
  background-color:#2d2d2d;
  color:#5a5a5a;
  border:1px solid #3c3c3c;
}
QPushButton:focus{
  border:1px solid #4fc1ff;
}

/* ===== SpinBox ===== */
QSpinBox{
  background-color:#3c3c3c;
  border:1px solid #3c3c3c;
  border-radius:3px;
  color:#cccccc;
  padding:2px 4px;
}
QSpinBox:hover{
  border:1px solid #707070;
}
QSpinBox:focus{
  border:1px solid #007acc;
}

/* ===== ProgressBar ===== */
QProgressBar{
  background-color:#3c3c3c;
  border:1px solid #3c3c3c;
  border-radius:3px;
  text-align:center;
  color:#ffffff;
}
QProgressBar::chunk{
  background-color:#007acc;
  border-radius:2px;
}
